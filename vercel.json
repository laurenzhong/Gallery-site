{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/photos/([^/]+)/?", "dest": "/photo-pages/$1.html", "check": true },
    {
      "src": "/static/(.*)",
      "dest": "/studio/static/$1"
    },
    {
      "src": "/studio/((?!static/).*)",
      "dest": "/studio/index.html"
    },
    {
      "src": "/photos/[^/]+/?",
      "dest": "/index.html"
    },
    {
      "src": "/stories/[^/]+/?",
      "dest": "/index.html"
    },
    {
      "src": "/((?!api/|assets/|hero/|footer/|photo-pages/|studio/|icons.svg|brand-mark.svg|favicon.svg|minimax-logo.png|archive-image.avif).*)",
      "dest": "/index.html"
    }
  ]
}
